{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "cargo": {
    "rangeStrategy": "update-lockfile"
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "rangeStrategy": "update-lockfile",
      "enabled": true
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "addLabels": [
        "rust"
      ]
    },
    {
      "groupName": "serde packages",
      "matchPackageNames": [
        "/^serde[-_]?/"
      ]
    },
    {
      "groupName": "tokio packages",
      "matchPackageNames": [
        "/^tokio[-_]?/"
      ]
    },
    {
      "groupName": "tracing packages",
      "matchPackageNames": [
        "/^tracing[-_]?/"
      ]
    },
    {
      "matchPackageNames": [
        "hyper-rustls",
        "rustls",
        "rustls-native-certs",
        "tokio-rustls",
        "webpki",
        "webpki-roots"
      ],
      "groupName": "rustls packages"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Rust dependencies auto-merge (patch)"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "docker"
      ]
    }
  ],
  "extends": [
    "config:recommended"
  ]
}
