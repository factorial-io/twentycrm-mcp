# TwentyCRM API
TWENTYCRM_API_TOKEN=your_twentycrm_api_token
TWENTYCRM_API_URL=https://api.twenty.com/rest

# Access control — comma-separated list of OIDC group names (e.g. GitLab groups)
# User must be a member of at least one of these groups to access the server
REQUIRED_GROUPS=my-gitlab-group,my-gitlab-group/subgroup

# OIDC provider (GitLab example)
OIDC_ISSUER_URL=https://gitlab.example.com
OIDC_CLIENT_ID=your_client_id
OIDC_CLIENT_SECRET=your_client_secret

# Server
BASE_URL=https://your-server.example.com
BIND_ADDR=0.0.0.0:8080

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Access token signing secret (base64, 32+ bytes): openssl rand -base64 32
TOKEN_SIGNING_KEY=your_base64_encoded_secret

# Logging
RUST_LOG=info
